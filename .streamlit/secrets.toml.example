# Template only. Copy to secrets.toml for LOCAL use, or paste the contents into
# Streamlit Cloud → app → Settings → Secrets. Never commit the real file.
#
# ─────────────────────────────────────────────────────────────────────────────
# READ THIS BEFORE SETTING KEYS ON A PUBLIC DEPLOYMENT
#
# The app reads these keys and pre-fills the sidebar with them. If you set them
# on a publicly reachable deployment, ANY visitor can run Claude calls and
# Street View fetches billed to your accounts, with no limit and no login.
#
# For a public paper demo, leave BOTH blank. The app runs fine without them:
# visitors browse all 23,190 scored segments, and anyone who wants to grade
# pavement pastes their own key into the sidebar.
#
# Only set them if the app is private (Streamlit Cloud allows restricting an
# app to specific viewers) or behind your own auth.
# ─────────────────────────────────────────────────────────────────────────────

# ANTHROPIC_API_KEY = "sk-ant-..."
# GOOGLE_MAPS_API_KEY = "AIza..."
